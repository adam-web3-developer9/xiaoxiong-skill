+            Box::pin(async move {
+                self.calls.lock().unwrap().push((channel.into(), args));
+                let (expected, result) = self
+                    .responses
+                    .lock()
+                    .unwrap()
+                    .pop_front()
+                    .expect("unexpected host invocation");
+                assert_eq!(channel, expected);
+                Ok(result)
+            })
+        }
