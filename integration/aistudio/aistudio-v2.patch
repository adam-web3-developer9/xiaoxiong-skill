+    "channelPluginBindings",
+    "inheritCredentials",
+    "channelPluginCapabilities",
+    "capabilities",
+    "videoResolution",
+    "videoAspectRatio",
+    "videoDuration",
+    "videoCopies",
+    "videoTaskConcurrency",
+    "videoPollIntervalSeconds",
+    "videoPollTimeoutMinutes",
+    "imageSize",
+    "imageQuality",
+    "imageAspectRatio",
+    "imageCount",
+    "imageMode",
